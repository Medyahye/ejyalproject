DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Used by docker-compose for the postgres service
POSTGRES_DB=educonnect
POSTGRES_USER=educonnect
POSTGRES_PASSWORD=educonnect
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection string consumed by Django (django-environ)
DATABASE_URL=postgres://educonnect:educonnect@db:5432/educonnect
